# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/dayflow_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
# Generate a secure 256-bit+ random secret for production
JWT_SECRET=DayFlowSecretKeyForJwtAuthenticationMustBeAtLeast256BitsLong2026!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
